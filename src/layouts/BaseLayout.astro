---
import BaseHead from '../components/layout/BaseHead.astro';
import CookieBanner from '../components/layout/CookieBanner';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import '../styles/global.css';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalUrl?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">
      {Astro.currentLocale === 'es' ? 'Ir al contenido' : Astro.currentLocale === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>
    <slot />
    <CookieBanner
      client:idle
      privacyUrl="/legal/privacy"
      message={t.cookies.message}
      learnMore={t.cookies.learnMore}
      accept={t.cookies.accept}
      optOut={t.cookies.optOut}
    />
  </body>
</html>
