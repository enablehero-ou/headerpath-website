---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import PromoBar from '../components/layout/PromoBar.astro';
import SignupForm from '../components/signup/SignupForm';
import { brand } from '../config/brand';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout
  title="Sign up"
  description={`Create your ${brand.name} academy. Takes less than 2 minutes.`}
>
  {recaptchaSiteKey && (
    <script slot="head" is:inline src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} async defer></script>
  )}
  <PromoBar />
  <Header />
  <main id="main-content" class="atmosphere min-h-screen bg-bg-primary">
    <SignupForm client:load s={t.signup} />
  </main>
</BaseLayout>
