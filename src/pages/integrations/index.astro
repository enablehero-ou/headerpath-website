---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const items = (await getCollection('integrations', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<PageLayout title={t.integrations.title} description={t.integrations.subtitle}>
  <Container class="py-16 lg:py-24">
    <div class="mb-12">
      <h1 class="text-4xl font-semibold text-text-primary">{t.integrations.title}</h1>
      <p class="mt-3 text-lg text-text-secondary">{t.integrations.subtitle}</p>
    </div>

    {
      items.length === 0 ? (
        <p class="text-text-muted">Integration pages coming soon.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <Card href={`/integrations/${item.id.replace(/^[a-z]{2}\//, '')}`}>
              <div class="mb-3 flex items-center justify-between">
                <Badge>{item.data.category}</Badge>
              </div>
              <h2 class="text-base font-semibold text-text-primary">{item.data.title}</h2>
              <p class="mt-2 text-sm text-text-secondary line-clamp-2">
                {item.data.description}
              </p>
            </Card>
          ))}
        </div>
      )
    }
  </Container>
</PageLayout>
