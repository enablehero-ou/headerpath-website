---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const items = (await getCollection('alternatives', ({ data }) => !data.draft))
  .sort((a, b) => a.data.competitor.localeCompare(b.data.competitor));
---

<PageLayout title={t.alternatives.title} description={t.alternatives.subtitle}>
  <Container class="py-16 lg:py-24">
    <div class="mb-12">
      <h1 class="text-4xl text-text-primary lg:text-5xl">{t.alternatives.title}</h1>
      <p class="mt-3 text-lg text-text-secondary">{t.alternatives.subtitle}</p>
    </div>

    {
      items.length === 0 ? (
        <p class="text-text-muted">Comparison pages coming soon.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <Card href={`/alternatives/${item.id.replace(/^[a-z]{2}\//, '')}`}>
              <h2 class="text-base font-semibold text-text-primary">
                vs {item.data.competitor}
              </h2>
              <p class="mt-2 text-sm text-text-secondary line-clamp-3">
                {item.data.description}
              </p>
            </Card>
          ))}
        </div>
      )
    }
  </Container>
</PageLayout>
