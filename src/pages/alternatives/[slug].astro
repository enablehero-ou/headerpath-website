---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/ui/Container.astro';

export async function getStaticPaths() {
  const items = await getCollection('alternatives', ({ data }) => !data.draft);
  return items.map((item) => {
    const slug = item.id.replace(/^[a-z]{2}\//, '');
    return { params: { slug }, props: { item } };
  });
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ContentLayout
  title={`vs ${item.data.competitor}`}
  description={item.data.description}
  backHref="/alternatives"
  backLabel="All alternatives"
>
  {
    (item.data.pros.length > 0 || item.data.cons.length > 0) && (
      <div class="not-prose mb-8 grid gap-4 sm:grid-cols-2">
        {item.data.pros.length > 0 && (
          <div class="rounded-lg border border-border bg-bg-card p-4">
            <h3 class="mb-3 text-sm font-semibold text-accent">Why choose us</h3>
            <ul class="space-y-2">
              {item.data.pros.map((pro: string) => (
                <li class="flex items-start gap-2 text-sm text-text-secondary">
                  <svg class="mt-0.5 shrink-0 text-accent" width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {pro}
                </li>
              ))}
            </ul>
          </div>
        )}
        {item.data.cons.length > 0 && (
          <div class="rounded-lg border border-border bg-bg-card p-4">
            <h3 class="mb-3 text-sm font-semibold text-text-muted">Where they win</h3>
            <ul class="space-y-2">
              {item.data.cons.map((con: string) => (
                <li class="flex items-start gap-2 text-sm text-text-secondary">
                  <svg class="mt-0.5 shrink-0 text-text-muted" width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  {con}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }

  <Content />

  {
    item.data.verdict && (
      <div class="not-prose mt-8 rounded-lg border border-accent/30 bg-accent/5 p-6">
        <p class="text-sm font-semibold text-accent mb-2">Our verdict</p>
        <p class="text-sm text-text-secondary">{item.data.verdict}</p>
      </div>
    )
  }
</ContentLayout>
