---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { brand } from '../config/brand';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const plan = brand.pricing.flat;

const features = [
  'Unlimited courses',
  'Unlimited learners',
  'AI course generation',
  'Auto-translations (80+ languages)',
  'Certifications',
  'Custom domain & white-label',
  'Integrations',
  'Analytics & reports',
  'Security & access controls',
];
---

<PageLayout title={t.pricing.title} description={t.pricing.subtitle}>
  <Container class="py-16 lg:py-24">
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h1 class="text-4xl text-text-primary lg:text-5xl">{t.pricing.title}</h1>
      <p class="mt-4 text-lg text-text-secondary">{t.pricing.subtitle}</p>
    </div>

    <div class="mx-auto max-w-md">
      <div class="rounded-2xl border border-accent/30 bg-accent/5 p-8">
        <h2 class="text-lg font-semibold text-text-primary">{plan.name}</h2>
        <p class="mt-2 text-sm text-text-secondary">{t.pricing.flat.description}</p>
        <div class="mt-6 flex items-baseline gap-1">
          <span class="text-5xl font-semibold text-text-primary">{plan.price}</span>
          <span class="text-text-muted">{plan.period}</span>
        </div>
        <Button href={brand.signupUrl} variant="primary" class="mt-6 w-full" size="lg">
          {t.pricing.flat.cta}
        </Button>
        <ul class="mt-8 space-y-3">
          {features.map((f) => (
            <li class="flex items-center gap-2.5 text-sm text-text-secondary">
              <svg class="shrink-0 text-accent-fg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <p class="mt-6 text-center text-xs text-text-muted">
        {t.pricing.fairUsage}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-md surface p-6 text-center">
      <h2 class="font-serif text-lg text-text-primary">Need something custom?</h2>
      <p class="mt-2 text-sm text-text-secondary">
        Custom pricing is available for advanced needs — higher volumes, custom
        integrations, procurement, or security reviews.
      </p>
      <a
        href={`mailto:${brand.email.team}`}
        class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-action no-underline hover:text-action-hover"
      >
        Contact {brand.email.team}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </Container>
</PageLayout>
