---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const items = (await getCollection('techniques', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const byCategory = items.reduce((acc, item) => {
  const cat = item.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {} as Record<string, typeof items>);
---

<PageLayout title={t.techniques.title} description={t.techniques.subtitle}>
  <Container class="py-16 lg:py-24">
    <div class="mb-12">
      <h1 class="text-4xl font-semibold text-text-primary">{t.techniques.title}</h1>
      <p class="mt-3 text-lg text-text-secondary">{t.techniques.subtitle}</p>
    </div>

    {
      items.length === 0 ? (
        <p class="text-text-muted">Technique pages coming soon.</p>
      ) : (
        <div class="space-y-12">
          {Object.entries(byCategory).map(([cat, catItems]) => (
            <div>
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent-fg capitalize">
                {cat}
              </h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {catItems.map((item) => (
                  <Card href={`/techniques/${item.id.replace(/^[a-z]{2}\//, '')}`}>
                    <Badge class="mb-3">{item.data.category}</Badge>
                    <h3 class="text-base font-semibold text-text-primary">{item.data.title}</h3>
                    <p class="mt-2 text-sm text-text-secondary line-clamp-2">
                      {item.data.description}
                    </p>
                  </Card>
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </Container>
</PageLayout>
