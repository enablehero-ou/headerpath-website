---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { brand } from '../config/brand';

const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
    title: 'AI Course Generator',
    description: 'Generate complete course structures from a brief. AI drafts the curriculum, you refine it.',
    href: '/ai-course-generator',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>`,
    title: 'AI Curriculum Design',
    description: 'Map learning outcomes to curriculum automatically. Define what learners need to do, not just know.',
    href: '/ai-curriculum',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Multi-audience Academies',
    description: 'Run separate academies for employees, partners, and customers — all from one platform.',
    href: '/platform',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Learning Analytics',
    description: 'Track completion, engagement, and outcomes. Know what is working and what is not.',
    href: '/platform',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Custom Domains',
    description: 'Each academy runs on your own domain. Fully white-labeled, no platform branding.',
    href: '/platform',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    title: 'Integrations',
    description: 'Connect your HRIS, CRM, SSO, and video tools. Learners don\'t need another login.',
    href: '/integrations',
  },
];
---

<PageLayout
  title="Platform"
  description={`Everything you need to run high-impact education programs. Built for organizations, not course creators.`}
>
  <Container class="py-16 lg:py-24">
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h1 class="text-4xl font-semibold text-text-primary lg:text-5xl">
        The complete platform for organizational learning
      </h1>
      <p class="mt-5 text-lg text-text-secondary">
        Everything you need to design, run, and measure education programs —
        for your team, your partners, or your customers.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <Button href="/signup" variant="primary" size="lg">Get started</Button>
        <Button href="/schedule" variant="secondary" size="lg">Book a demo</Button>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <Card href={feature.href}>
            <div class="mb-4 inline-flex rounded-lg bg-accent/10 p-2.5 text-accent">
              <Fragment set:html={feature.icon} />
            </div>
            <h2 class="font-semibold text-text-primary">{feature.title}</h2>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">
              {feature.description}
            </p>
          </Card>
        ))
      }
    </div>
  </Container>
</PageLayout>
