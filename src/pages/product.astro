---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import ProductFeatures from '../components/sections/ProductFeatures.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

// Feature-focused FAQ — answers the "how does it actually work" questions a
// buyer asks while scanning the capability wall above.
const productFaqs = [
  {
    question: 'How does the AI build courses?',
    answer:
      'The Course Creation Agent reads your material — docs, slides, video — and drafts a structured course: outline, sections, and steps. You edit anything before it goes live, so the AI saves the hours without taking away control.',
  },
  {
    question: 'Can I build a course manually instead?',
    answer:
      'Yes. Every course is fully editable, and you can build one from scratch step by step. AI generation is a starting point, never a requirement.',
  },
  {
    question: 'What content formats can learners consume?',
    answer:
      'Text, images, video, quizzes, and knowledge checks — all mobile-ready with secure, adaptive playback. Videos stream like YouTube but stay inside your academy.',
  },
  {
    question: 'How do certifications work?',
    answer:
      'Generate branded certificates automatically when learners complete a path. They can download a PDF or share the credential straight to LinkedIn.',
  },
  {
    question: 'How many languages are supported?',
    answer:
      'Translate your entire academy into 80+ languages in one click. Translations sound natural, stay fully editable, and learners see the right language automatically.',
  },
  {
    question: 'How do I measure impact?',
    answer:
      'Track real-time progress and engagement per learner, then connect learning actions to business metrics like clicks, sales, or orders. Export the data and query it directly.',
  },
];
---

<PageLayout title={t.product.heroTitle} description={t.product.heroSubtitle}>
  <ProductFeatures />
  <FAQ eyebrow={t.product.faqLabel} title={t.product.faqTitle} items={productFaqs} />
  <CTA />
</PageLayout>
