---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import { brand } from '../config/brand';
---

<PageLayout
  title="Careers"
  description={`Join the ${brand.name} team.`}
>
  <Container class="py-16 lg:py-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-semibold text-text-primary">Careers</h1>
      <p class="mt-4 text-lg text-text-secondary">
        We're a small, focused team building something ambitious. We hire for judgment and
        craft, not credentials.
      </p>

      <div class="mt-12">
        <h2 class="text-xl font-semibold text-text-primary mb-6">Open roles</h2>
        <div class="rounded-xl border border-border bg-bg-card p-8 text-center">
          <p class="text-text-muted">No open roles right now.</p>
          <p class="mt-2 text-sm text-text-muted">
            We're always interested in exceptional people. If that's you, reach out at{' '}
            <a href={`mailto:${brand.email.support}`} class="text-accent">{brand.email.support}</a>.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-xl font-semibold text-text-primary mb-4">What we value</h2>
        <ul class="space-y-4">
          {[
            ['Outcomes over output', 'We care about what actually happens as a result of work, not how much work was done.'],
            ['Clarity', 'Clear thinking, clear writing, clear communication. We default to simple.'],
            ['Craft', 'We care about the quality of what we ship. Good enough rarely is.'],
            ['Autonomy', 'We hire people we trust, then trust them.'],
          ].map(([title, desc]) => (
            <li class="border-b border-border pb-4">
              <p class="font-medium text-text-primary">{title}</p>
              <p class="mt-1 text-sm text-text-secondary">{desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</PageLayout>
