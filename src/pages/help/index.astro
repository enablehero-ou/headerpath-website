---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';

// Human-readable labels + display order for help categories (Webflow source).
const categories: { slug: string; label: string }[] = [
  { slug: 'accounts', label: 'Accounts' },
  { slug: 'create-content', label: 'Create content' },
  { slug: 'customize-your-qurioos-account', label: 'Customize theme' },
  { slug: 'hosting-domains', label: 'Hosting & domains' },
  { slug: 'localization', label: 'Localization' },
  { slug: 'certifications', label: 'Certifications' },
  { slug: 'progress-tracking', label: 'Progress tracking' },
  { slug: 'reports', label: 'Reports' },
  { slug: 'emails', label: 'Emails' },
  { slug: 'integrations-api', label: 'Integrations & API' },
  { slug: 'security', label: 'Security' },
];

const articles = await getCollection('docs', ({ data }) => !data.draft);

const slugOf = (id: string) => id.split('/').pop()!;
const catOf = (a: (typeof articles)[number]) =>
  a.data.category ?? a.id.split('/')[1];

const grouped = categories
  .map((c) => ({
    ...c,
    items: articles
      .filter((a) => catOf(a) === c.slug)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }))
  .filter((c) => c.items.length > 0);
---

<PageLayout
  title="Help center"
  description="Guides, answers, and how-tos for getting the most out of Qurioos."
>
  <Container class="py-16 lg:py-24">
    <div class="mb-12 max-w-3xl">
      <h1 class="text-4xl font-semibold text-text-primary">Help center</h1>
      <p class="mt-3 text-lg text-text-secondary">
        Guides, answers, and how-tos for getting the most out of Qurioos.
      </p>
    </div>

    <div class="space-y-12">
      {
        grouped.map((cat) => (
          <section>
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-text-muted">
              {cat.label}
            </h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {cat.items.map((a) => (
                <Card href={`/help/${slugOf(a.id)}`}>
                  <h3 class="font-semibold text-text-primary">{a.data.title}</h3>
                  {a.data.description && (
                    <p class="mt-2 text-sm text-text-secondary line-clamp-2">
                      {a.data.description}
                    </p>
                  )}
                </Card>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </Container>
</PageLayout>
