---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={t.blog.title} description={t.blog.subtitle}>
  <Container class="py-16 lg:py-24">
    <div class="mb-12">
      <h1 class="text-4xl font-semibold text-text-primary">{t.blog.title}</h1>
      <p class="mt-3 text-lg text-text-secondary">{t.blog.subtitle}</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-text-muted">No posts yet. Check back soon.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <Card href={`/blog/${post.id.replace(/^[a-z]{2}\//, '')}`}>
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="mb-4 w-full rounded-lg aspect-video object-cover border border-border"
                />
              )}
              <div class="mb-3">
                <Badge>{post.data.category}</Badge>
              </div>
              <h2 class="text-base font-semibold text-text-primary leading-snug">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm text-text-secondary line-clamp-2">
                {post.data.description}
              </p>
              <p class="mt-4 text-xs text-text-muted">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </Card>
          ))}
        </div>
      )
    }
  </Container>
</PageLayout>
