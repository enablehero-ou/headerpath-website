---
import { getCollection, render } from 'astro:content';
import ProposalLayout from '../../layouts/ProposalLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('proposals', ({ data }) => !data.draft);
  return items.map((item) => {
    const slug = item.id.replace(/^[a-z]{2}\//, '');
    return { params: { slug }, props: { item } };
  });
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ProposalLayout
  title={item.data.title}
  client={item.data.client}
  date={item.data.date}
  expiresAt={item.data.expiresAt}
>
  <Content />
</ProposalLayout>
