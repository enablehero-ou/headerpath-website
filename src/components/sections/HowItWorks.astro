---
import Container from '../ui/Container.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const steps = [
  {
    number: 'Step 1',
    outcome: 'Upload',
    title: 'Bring what you already have',
    description:
      'Drop in your documents, videos, and slides. Qurioos reads your material and turns it into structured, ready-to-edit courses.',
    items: [
      { label: 'Any format', detail: 'Docs, PDFs, slides, and video — all welcome.' },
      { label: 'Start with your goal', detail: 'Tell us the outcome and the academy is built around it.' },
    ],
  },
  {
    number: 'Step 2',
    outcome: 'Build with AI',
    title: 'AI builds the academy and the courses',
    description:
      'The Academy Building Agent sets up your space with proven defaults, and the Course Creation Agent drafts every course. You review and refine — no instructional designers needed.',
    items: [
      { label: 'Academy Building Agent', detail: 'A working academy with smart defaults, instantly.' },
      { label: 'Course Creation Agent', detail: 'Every course outlined and drafted for you.' },
    ],
  },
  {
    number: 'Step 3',
    outcome: 'Publish',
    title: 'Go live and measure',
    description:
      'Publish on your own domain, invite learners by email, link, or QR, and watch progress, completion, and outcomes in real time.',
    items: [
      { label: 'Your brand, your domain', detail: 'White-labeled, with SSL included.' },
      { label: 'Track outcomes', detail: 'See engagement and export your data anytime.' },
    ],
  },
];
---

<section class="bg-bg-primary py-20 lg:py-28">
  <Container>
    <div class="mb-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">
        {t.home.howItWorksLabel}
      </p>
      <h2 class="text-3xl font-semibold text-text-primary lg:text-4xl">
        {t.home.howItWorksTitle}
      </h2>
    </div>

    <div class="space-y-4">
      {
        steps.map((step, i) => (
          <details
            class="group rounded-xl border border-border bg-bg-card overflow-hidden"
            open={i === 0}
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 select-none list-none">
              <div class="flex items-center gap-4">
                <span class="inline-flex rounded-full bg-bg-tertiary px-3 py-1 text-sm font-medium text-text-secondary">
                  {step.number}
                </span>
                <span class="font-medium text-text-primary">{step.title}</span>
              </div>
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                class="shrink-0 text-text-muted transition-transform group-open:rotate-180"
              >
                <path d="M3 5.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>

            <div class="grid gap-6 px-6 pb-6 pt-2 md:grid-cols-2">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-accent">
                  {step.outcome}
                </span>
                <p class="mt-3 text-text-secondary text-sm leading-relaxed">
                  {step.description}
                </p>
              </div>
              <div class="space-y-4">
                {step.items.map((item) => (
                  <div>
                    <p class="font-medium text-text-primary text-sm">{item.label}</p>
                    <p class="text-sm text-text-muted mt-0.5">{item.detail}</p>
                  </div>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>
