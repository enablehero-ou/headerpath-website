---
import Container from '../ui/Container.astro';
import FAQAccordion from './FAQAccordion';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const faqs = [
  {
    question: 'Do I need instructional designers or developers?',
    answer:
      'No. The Academy Building Agent sets up your academy and the Course Creation Agent drafts your courses. You review, edit, and publish — no design or technical skills required.',
  },
  {
    question: 'Can I use my own branding and domain?',
    answer:
      'Yes. Every academy is fully white-labeled and runs on your own domain, with SSL included by default. Learners see your brand, not ours.',
  },
  {
    question: 'What can I train people on?',
    answer:
      'Anything — customer education, partner enablement, and employee onboarding or upskilling — all from one account.',
  },
  {
    question: 'How many languages are supported?',
    answer:
      'Translate your entire academy into 80+ languages in one click. AI translations sound natural and stay fully editable, and learners see the right language automatically.',
  },
  {
    question: 'Is my content private and secure?',
    answer:
      'Yes. You choose public, invite-only, or restricted access, backed by enterprise-grade encryption and GDPR-ready privacy controls.',
  },
  {
    question: 'How does pricing work?',
    answer:
      'One flat plan at $150/month with everything unlimited, subject to our fair usage policy.',
  },
];
---

<section class="bg-bg-primary py-20 lg:py-28">
  <Container>
    <div class="mx-auto max-w-2xl">
      <div class="mb-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">
          {t.home.faqLabel}
        </p>
        <h2 class="text-3xl font-semibold text-text-primary lg:text-4xl">
          {t.home.faqTitle}
        </h2>
      </div>

      <FAQAccordion client:visible items={faqs} />
    </div>
  </Container>
</section>
