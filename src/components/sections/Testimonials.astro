---
import Container from '../ui/Container.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const testimonials = [
  {
    quote: 'The experience we created is both engaging and insightful!',
    name: 'Natasha Steetz',
    title: 'Head of Revenue at Naven',
  },
  {
    quote: "Very excited about the way this works. The user feedback is just epic!",
    name: 'Jim Vlachus',
    title: 'Head of Operations at Distream',
  },
  {
    quote: 'High quality results at a rapid pace and invaluable insights!',
    name: 'Peter Wailes',
    title: 'Founder & CEO at Formulize',
  },
  {
    quote: 'We redefined our strategy and this allowed us to move fast and get results!',
    name: 'Franz Emparchinger',
    title: 'Product Director at Storro',
  },
  {
    quote: 'Good communication and extremely professional. This is just excellent for us.',
    name: 'Adam Rumpus',
    title: 'Administrator at Lynton',
  },
  {
    quote: "They went above and beyond. I can't recommend this collaboration enough.",
    name: 'Tim Elharrington-Judge',
    title: 'Founder at Haptic Pledge',
  },
];
---

<section class="bg-bg-secondary py-20 lg:py-28">
  <Container>
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow eyebrow--accent mb-5">{t.home.testimonialsLabel}</p>
      <h2 class="text-3xl text-text-primary lg:text-[2.75rem]">
        {t.home.testimonialsTitle}
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((item) => (
          <figure class="surface flex flex-col p-7">
            <blockquote class="font-serif text-lg italic leading-snug text-text-primary">
              “{item.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-border-subtle pt-5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/10 font-serif text-sm text-accent ring-1 ring-accent/15">
                {item.name.charAt(0)}
              </span>
              <span>
                <span class="block text-sm font-semibold text-text-primary">{item.name}</span>
                <span class="block text-xs text-text-muted">{item.title}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Container>
</section>
