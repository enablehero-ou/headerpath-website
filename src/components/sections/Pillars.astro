---
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const icons = [
  // Internal
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  // Partner
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  // Customer
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  // Engagement
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
];

const pillars = [
  { key: 'internal', ...t.pillars.internal },
  { key: 'partner', ...t.pillars.partner },
  { key: 'customer', ...t.pillars.customer },
  { key: 'engagement', ...t.pillars.engagement },
];
---

<section class="bg-bg-secondary py-20 lg:py-28">
  <Container>
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">
        {t.home.whatWeDoLabel}
      </p>
      <h2 class="text-3xl font-semibold text-text-primary lg:text-4xl max-w-xl">
        {t.home.whatWeDoTitle}
      </h2>
      <p class="mt-4 max-w-xl text-text-secondary">
        {t.home.whatWeDoSubtitle}
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((pillar, i) => (
          <Card>
            <div class="mb-4 inline-flex rounded-lg bg-accent/10 p-2.5 text-accent">
              <Fragment set:html={icons[i]} />
            </div>
            <h3 class="mb-2 font-semibold text-text-primary">{pillar.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{pillar.description}</p>
          </Card>
        ))
      }
    </div>
  </Container>
</section>
