---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { brand } from '../../config/brand';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
---

<section class="bg-bg-primary py-20 lg:py-28">
  <Container>
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-bg-secondary px-8 py-16 text-center lg:px-16"
    >
      <!-- Background gradient -->
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_80%_at_50%_120%,rgba(16,185,129,0.12),transparent)]"
      >
      </div>

      <h2 class="relative text-3xl font-semibold text-text-primary lg:text-4xl max-w-xl mx-auto">
        {t.home.ctaTitle}
      </h2>
      <p class="relative mt-4 text-text-secondary max-w-md mx-auto">
        {t.home.ctaSubtitle}
      </p>
      <div class="relative mt-8">
        <Button href={brand.signupUrl} variant="primary" size="lg">
          {t.home.ctaButton}
        </Button>
      </div>
    </div>
  </Container>
</section>
