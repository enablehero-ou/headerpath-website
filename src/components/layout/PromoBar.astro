---
// Site-wide intro-offer bar, sits above the header. Zero JS.
// The figures come from `brand.pricing.promo` (the single price source) and the
// signup link carries the promo UTM so a submission attributes back to this bar.
// To retire the offer, remove <PromoBar /> from PageLayout / the signup page.
import { brand } from '../../config/brand';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const promo = brand.pricing.promo;
const price = `${promo.price}${promo.period}`;

const fill = (template: string) =>
  template.replace('{price}', price).replace('{months}', String(promo.months));

const params = new URLSearchParams({
  utm_source: promo.utm.source,
  utm_medium: promo.utm.medium,
  utm_campaign: promo.utm.campaign,
});
const href = `${brand.signupUrl}?${params.toString()}`;
---

<div class="bg-action text-action-fg">
  <a
    href={href}
    class="flex items-center justify-center gap-2 overflow-hidden px-4 py-2 text-center no-underline whitespace-nowrap"
  >
    <span class="hidden text-xs font-medium tracking-wide text-accent sm:inline">
      {t.promoBar.label}
    </span>
    <span class="hidden text-action-fg/30 sm:inline" aria-hidden="true">·</span>
    <span class="text-xs font-medium sm:text-sm">
      <span class="sm:hidden">{fill(t.promoBar.textShort)}</span>
      <span class="hidden sm:inline">{fill(t.promoBar.text)}</span>
    </span>
    <span class="text-xs font-semibold text-accent underline underline-offset-2 sm:text-sm">
      {t.promoBar.cta} &rarr;
    </span>
  </a>
</div>
