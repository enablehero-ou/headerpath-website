---
import Container from '../ui/Container.astro';
import { brand } from '../../config/brand';
import { nav } from '../../config/navigation';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-secondary mt-24">
  <Container>
    <div class="py-12 lg:py-16">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
        <!-- Brand column -->
        <div class="col-span-2 md:col-span-4 lg:col-span-1">
          <a href="/" class="inline-block no-underline" aria-label={brand.name}>
            <img
              src="/images/qurioos-logo.png"
              alt={brand.name}
              class="h-8 w-auto"
              width="1000"
              height="300"
            />
          </a>
          <p class="mt-3 text-sm text-text-muted max-w-xs">
            {brand.tagline}
          </p>
          {
            brand.social.linkedin && (
              <a
                href={brand.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-2 text-sm text-text-muted no-underline hover:text-text-primary transition-colors"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
                LinkedIn
              </a>
            )
          }
        </div>

        <!-- Nav columns -->
        {
          Object.values(nav.footer).map((group) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-4">
                {group.label}
              </h3>
              <ul class="space-y-3 list-none m-0 p-0">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-text-secondary no-underline hover:text-text-primary transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row"
      >
        <p class="text-xs text-text-muted">
          © {year} {brand.name}. {t.footer.copyright}
        </p>
      </div>
    </div>
  </Container>
</footer>
