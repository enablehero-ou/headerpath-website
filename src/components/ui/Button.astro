---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium rounded-full transition-all duration-200 cursor-pointer no-underline';

const variants = {
  primary:
    'bg-accent text-white hover:bg-accent-hover active:scale-95',
  secondary:
    'border border-border bg-bg-card text-text-primary hover:border-accent/50 hover:bg-bg-tertiary active:scale-95',
  ghost:
    'text-text-secondary hover:text-text-primary active:scale-95',
};

const sizes = {
  sm: 'text-sm px-4 py-2',
  md: 'text-sm px-5 py-2.5',
  lg: 'text-base px-6 py-3',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
