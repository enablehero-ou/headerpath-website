---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium rounded-full transition-all duration-200 cursor-pointer no-underline';

const variants = {
  primary:
    'bg-accent text-accent-fg shadow-[0_1px_2px_rgba(31,42,57,0.12),inset_0_1px_0_rgba(255,255,255,0.25)] hover:bg-accent-hover hover:shadow-[0_8px_20px_-6px_rgba(92,225,230,0.65)] active:scale-[0.98]',
  secondary:
    'bg-bg-card text-text-primary shadow-[0_0_0_1px_rgba(31,42,57,0.10),0_1px_2px_rgba(31,42,57,0.05)] hover:shadow-[0_0_0_1px_rgba(31,42,57,0.18),0_6px_16px_-4px_rgba(31,42,57,0.12)] active:scale-[0.98]',
  ghost:
    'text-text-secondary hover:text-text-primary active:scale-[0.98]',
};

const sizes = {
  sm: 'text-sm px-4 py-2',
  md: 'text-sm px-5 py-2.5',
  lg: 'text-base px-7 py-3.5',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
