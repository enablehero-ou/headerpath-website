---
interface Props {
  class?: string;
  href?: string;
}

const { class: className = '', href } = Astro.props;

const base = 'surface p-6';
const interactive = href ? 'surface-hover block no-underline' : '';
---

{
  href ? (
    <a href={href} class:list={[base, interactive, className]}>
      <slot />
    </a>
  ) : (
    <div class:list={[base, className]}>
      <slot />
    </div>
  )
}
