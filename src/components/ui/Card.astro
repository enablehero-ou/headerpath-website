---
interface Props {
  class?: string;
  href?: string;
}

const { class: className = '', href } = Astro.props;

const base =
  'rounded-xl border border-border bg-bg-card p-6 transition-colors duration-200';
const interactive = href ? 'hover:border-accent/30 hover:bg-bg-tertiary block no-underline' : '';
---

{
  href ? (
    <a href={href} class:list={[base, interactive, className]}>
      <slot />
    </a>
  ) : (
    <div class:list={[base, className]}>
      <slot />
    </div>
  )
}
